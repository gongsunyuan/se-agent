!set A = 需求处理
!set B = 分析判断
!set C = 生成澄清问题
!set D = 需求明确
!set E = 生成需求文档
!set F = 确认点A
!set G = 高层设计
!set H = 确认点B
!set I = 详细设计
!set J = 结束

$A ──→ $B ──┬── $D ──→ $E ──→ $F
    ▲        │                       │
    │        └── $C ──→ $A          ├── $D ──→ $G
    │              (循环提问)        │              │
    └───────────────────────────────┘          $H
    (需修改：返回$A)                             │
                                        ├── $D ──→ $I → $J
                                        └── 需修改 ──→ $G
